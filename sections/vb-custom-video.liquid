{% stylesheet %}
/* Styling for Video Section */
.video-section {
  position: relative;
  width: 100%;
  margin: 0 auto;
  padding-top: 56.25%; /* Aspect ratio of 16:9 for the video */
  background: #000;
  overflow: hidden;
}

.video-wrapper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.video {
  width: 100%;
  height: 100%;
  border: none;
}

.overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-color: var(--overlay-background-color);
  opacity: 0.7;
  display: flex;
  justify-content: center;
  align-items: center;
  color: var(--overlay-text-color);
  text-align: center;
}

.overlay-text {
  font-size: 30px;
  font-weight: bold;
  color: var(--overlay-text-color);
}

@media (max-width: 768px) {
  .overlay-text {
    font-size: 20px;
  }
}
{% endstylesheet %}

<div class="video-section">
  <div class="video-wrapper">
    <iframe class="video" 
            src="{{ section.settings.video_id }}" 
            frameborder="0" 
            allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture" 
            allowfullscreen></iframe>
  </div>
</div>

{% javascript %}
document.addEventListener('DOMContentLoaded', function () {
  // Set dynamic CSS variables based on Shopify settings
  const overlay = document.querySelector('.overlay');
  const overlayText = document.querySelector('.overlay-text');

  // Update overlay background and text colors
  overlay.style.backgroundColor = "{{ settings.overlay_background_color }}";
  overlayText.style.color = "{{ settings.overlay_text_color }}";
});
{% endjavascript %}

{% schema %}
{
  "name": "VB - Custom YT Video",
  "settings": [
    {
      "type": "text",
      "label": "Video ID",
      "id": "video_id",
      "default": "YOUR_VIDEO_ID",
      "info": "Enter the YouTube video ID"
    }
  ],
  "presets": [
    {
      "name": "VB - Custom YT Video",
      "category": "Custom"
    }
  ]
}
{% endschema %}