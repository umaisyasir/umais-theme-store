{% stylesheet %}
.banner-slider-container {
  width: 100%;
  position: relative;
  overflow: hidden;
}

.swiper-container {
  width: 100%;
  height: 100vh;
}

.swiper-slide {
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.banner-slide {
  width: 100%;
  height: 100%;
  background-size: cover;
  position: relative;
}

.banner-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 1;
}

.banner-content {
  position: absolute;
  z-index: 2;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
}

.banner-btn {
  display: inline-block;
  padding: 12px 25px;
  text-transform: uppercase;
  font-weight: bold;
  text-decoration: none;
  border-radius: 5px;
}

.swiper-pagination {
  position: absolute;
  bottom: 30px;
  left: 0;
  width: 100%;
  text-align: center;
}

.swiper-pagination-bullet {
  display: inline-block;
  width: 12px;
  height: 12px;
  border-radius: 50%;
  background: #ffffff;
  opacity: 0.5;
  margin: 0 5px;
  transition: opacity 0.3s;
}

.swiper-pagination-bullet-active {
  opacity: 1;
  background-color: #000000;
}

.swiper-button-next,
.swiper-button-prev {
  color: #fff;
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  z-index: 3;
}

.swiper-button-next {
  right: 10px;
}

.swiper-button-prev {
  left: 10px;
}

@media (max-width: 768px) {
  .swiper-container {
    height: 60vh;
  }
}

@media (max-width: 480px) {
  .swiper-container {
    height: 50vh;
  }
}
{% endstylesheet %}

<div class="banner-slider-container">
  <div class="swiper-container">
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        <div class="swiper-slide">
          <div class="banner-slide" 
               style="background-image: url({{ block.settings.image | img_url: '1920x1080' }}); background-position: {{ block.settings.bg_position }}; opacity: {{ block.settings.bg_opacity }};">
            <div class="banner-overlay" style="background-color: rgba(0, 0, 0, {{ block.settings.overlay_opacity }});"></div>
            <div class="banner-content" style="text-align: {{ block.settings.text_align }};">
              <h2 style="font-size: {{ block.settings.heading_size }}px; color: {{ block.settings.heading_color }};">
                {{ block.settings.heading }}
              </h2>
              <p style="font-size: {{ block.settings.subheading_size }}px; color: {{ block.settings.text_color }};">
                {{ block.settings.subheading }}
              </p>
              <a href="{{ block.settings.button_link }}" class="banner-btn" 
                 style="background-color: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }};">
                {{ block.settings.button_text }}
              </a>
            </div>
          </div>
        </div>
      {% endfor %}
    </div>

    <!-- Pagination (dots) -->
    <div class="swiper-pagination"></div>

    <!-- Navigation Arrows if enabled -->
    {% if section.settings.show_navigation %}
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>
    {% endif %}
  </div>
</div>

<script>
  var swiper = new Swiper('.swiper-container', {
    effect: 'fade',
    loop: true,
    autoplay: {
      delay: {{ section.settings.autoplay_delay }},
      disableOnInteraction: {{ section.settings.disable_on_interaction | json }},
    },
    navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true, // Make dots clickable
    },
    fadeEffect: {
      crossFade: true,
    },
  });
</script>

{% schema %}
{
  "name": "VB - Banner Slider",
  "settings": [
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay Delay (ms)",
      "min": 1000,
      "max": 5000,
      "step": 500,
      "default": 5000
    },
    {
      "type": "checkbox",
      "id": "disable_on_interaction",
      "label": "Disable autoplay on interaction",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_navigation",
      "label": "Show Navigation Arrows",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "banner_slide",
      "name": "Banner Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "range",
          "id": "bg_opacity",
          "label": "Background Image Opacity",
          "min": 0.1,
          "max": 1,
          "step": 0.1,
          "default": 1
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Overlay Opacity (Black Overlay)",
          "min": 0,
          "max": 1,
          "step": 0.1,
          "default": 0.3
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading Text"
        },
        {
          "type": "range",
          "id": "heading_size",
          "label": "Heading Font Size (px)",
          "min": 16,
          "max": 72,
          "default": 48
        },
        {
          "type": "color",
          "id": "heading_color",
          "label": "Heading Color",
          "default": "#ffffff"
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading Text"
        },
        {
          "type": "range",
          "id": "subheading_size",
          "label": "Subheading Font Size (px)",
          "min": 12,
          "max": 36,
          "default": 20
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Subheading Color",
          "default": "#ffffff"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "Text Alignment",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text"
        },
        {
          "type": "color",
          "id": "button_color",
          "label": "Button Background Color",
          "default": "#ffffff"
        },
        {
          "type": "color",
          "id": "button_text_color",
          "label": "Button Text Color",
          "default": "#000000"
        },
        {
          "type": "select",
          "id": "bg_position",
          "label": "Background Position",
          "options": [
            { "value": "center", "label": "Center" },
            { "value": "top", "label": "Top" },
            { "value": "bottom", "label": "Bottom" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "VB - Banner Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}