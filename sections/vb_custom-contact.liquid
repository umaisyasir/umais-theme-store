{% stylesheet %}
.contact-section {
            padding: 50px;
            text-align: center;
        }

        .contact-section h2 {
            font-size: 2.5rem;
            margin-bottom: 30px;
            animation: fadeInDown 1s ease-in-out;
        }

        .contact-container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 20px;
        }

        .contact-box {
            background-color: #2e4149;
            border-radius: 10px;
            padding: 20px;
            width: 300px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            animation: fadeInUp 1s ease-in-out;
            transition: transform 0.3s, box-shadow 0.3s;
        }

        .contact-box:hover {
            transform: translateY(-10px);
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.3);
        }

        .contact-box h3 {
            font-size: 1.5rem;
            margin-bottom: 10px;
            color: #c0d6df;
        }

        .contact-box p {
            margin: 10px 0;
        }

        .contact-box a {
            display: inline-block;
            background-color: #899d87;
            color: #fff;
            text-decoration: none;
            padding: 10px 20px;
            border-radius: 5px;
            transition: background-color 0.3s;
        }

        .contact-box a:hover {
            background-color: #6f836c;
        }

        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @media (max-width: 768px) {
            .contact-box {
                width: 100%;
                max-width: 500px;
            }
        }
{% endstylesheet %}

<section class="contact-section">
        <h2>{{ section.settings.heading }}</h2>
        <div class="contact-container">
            {% for block in section.blocks %}
                <div class="contact-box">
                    <h3>{{ block.settings.title }}</h3>
                    <p>{{ block.settings.subtitle }}</p>
                    <a href="tel:{{ block.settings.phone }}">{{ block.settings.phone }}</a>
                </div>
            {% endfor %}
        </div>
</section>

{% schema %}
  {
    "name": "Contact Section",
    "settings": [
        {
            "type": "text",
            "id": "heading",
            "label": "Section Heading",
            "default": "Contact Our Customer Service"
        },
        {
            "type": "color",
            "id": "background_color",
            "label": "Background Color",
            "default": "#1c2c33"
        },
        {
            "type": "color",
            "id": "text_color",
            "label": "Text Color",
            "default": "#ffffff"
        }
    ],
    "blocks": [
        {
            "type": "contact_box",
            "name": "Contact Box",
            "settings": [
                {
                    "type": "text",
                    "id": "title",
                    "label": "Title",
                    "default": "DIY Orders"
                },
                {
                    "type": "text",
                    "id": "subtitle",
                    "label": "Subtitle",
                    "default": "Se Habla Español"
                },
                {
                    "type": "text",
                    "id": "phone",
                    "label": "Phone Number",
                    "default": "9365534243"
                },
                {
                    "type": "color",
                    "id": "box_background_color",
                    "label": "Box Background Color",
                    "default": "#2e4149"
                },
                {
                    "type": "color",
                    "id": "button_color",
                    "label": "Button Background Color",
                    "default": "#899d87"
                },
                {
                    "type": "color",
                    "id": "button_hover_color",
                    "label": "Button Hover Color",
                    "default": "#6f836c"
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Contact Section",
            "category": "Custom"
        }
    ]
}
{% endschema %}